{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Release (Ninja + mold + ccache)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "LOOMWRIGHT_USE_MOLD": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "release-clang",
            "displayName": "Release with Clang (reference compiler)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "LOOMWRIGHT_USE_MOLD": "ON",
                "LOOMWRIGHT_REQUIRE_REFERENCE_COMPILER": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "release-gcc",
            "displayName": "Release with GCC",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "LOOMWRIGHT_USE_MOLD": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (Ninja + mold + ccache)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "LOOMWRIGHT_USE_MOLD": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "sanitize",
            "displayName": "Address and undefined behaviour sanitizers (Ninja + ccache)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/sanitize",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "LOOMWRIGHT_USE_MOLD": "ON",
                "LOOMWRIGHT_SANITIZE": "ON",
                "LOOMWRIGHT_HARDEN": "OFF",
                "BUILD_TESTING": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "release", "configurePreset": "release" },
        { "name": "release-clang", "configurePreset": "release-clang" },
        { "name": "release-gcc", "configurePreset": "release-gcc" },
        { "name": "debug", "configurePreset": "debug" },
        { "name": "sanitize", "configurePreset": "sanitize" }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true },
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "release-clang",
            "configurePreset": "release-clang",
            "output": { "outputOnFailure": true },
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "release-gcc",
            "configurePreset": "release-gcc",
            "output": { "outputOnFailure": true },
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "output": { "outputOnFailure": true },
            "execution": {
                "jobs": 4
            },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        }
    ]
}

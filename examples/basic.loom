# A tour of Loomwright's core actions and a few AutoHotkey-style features.
loom "basic-demo" {
    option output = "auto"
    option panic = "PAUSE"

    # Native remapping: F10 is withheld and emits Enter instead.
    remap key F10 to ENTER

    # A user-defined function. It returns a value and can be called from any
    # expression.
    func double(x) {
        return x * 2
    }

    when app starts {
        log "Loomwright is ready. F8 prints a message."
    }

    when key F8 goes down {
        notify "F8 reached Loomwright"
        log "pressed F8"
    }

    when key F8 goes up {
        log "released F8"
    }

    when key F9 goes down {
        cursor center
        mouse left tap for 90ms
    }

    when key F11 goes down {
        set window = active_window_process()
        if window == "" {
            log "active window query requires xdotool or kdotool"
        } else if window == "firefox" {
            log "Firefox is in front"
        } else {
            log "active window: " + window
        }
    }

    when key F12 goes down {
        send "Loomwright{enter}"
    }

    # A for loop over a range, with a list of names.
    when key F7 goes down {
        set names = ["alpha", "beta", "gamma"]
        for name in names {
            log name + " -> " + str(double(len(name)))
        }
        for i = 1 to 3 {
            log "round " + str(i)
        }
    }
}

# Maintainer: Keyloom contributors
#
# Builds and installs keyloom from a local checkout of this repository; no
# release tarball or network access is involved. Run:
#
#     cd packaging/arch
#     makepkg -si
#
# The source is whatever the checkout contains, committed or not, so this is
# also the way to package work in progress. To publish the package, point
# _keyloom_source_dir at a published source instead of the checkout.

pkgname=keyloom
# Keep this in sync with project(keyloom VERSION ...) in ../../CMakeLists.txt.
pkgver=0.5.2
pkgrel=1
pkgdesc='Linux-first desktop automation language and runtime'
arch=(x86_64 aarch64)
license=(MIT)
# Release artifacts contain the main package only; avoid a distribution-default
# split debug package appearing alongside it when makepkg enables debug symbols.
options=(!debug)
# X11 and libpng support the picker; XCB supports GUI transport development.
depends=(
    glibc
    gcc-libs
    libx11
    libxcb
    libpng
    gtk3
    wayland
)
makedepends=(
    'cmake>=3.25'
    ninja
    pkgconf
)
# ydotool/ydotoold is the preferred output backend for keys, buttons and
# Unicode text. The rest are only needed by specific features: the picker
# captures the desktop with one of the screenshot tools, and clipboard
# integration uses wl-copy/wl-paste or xclip/xsel.
optdepends=(
    'ydotool: buttons, keys and Unicode text via ydotoold (preferred output backend)'
    'spectacle: desktop screenshot for --get-mouse-pos (KDE)'
    'grim: desktop screenshot for --get-mouse-pos (wlroots)'
    'gnome-screenshot: desktop screenshot for --get-mouse-pos (GNOME)'
    'scrot: desktop screenshot for --get-mouse-pos'
    'imagemagick: ImageMagick import as a screenshot fallback for --get-mouse-pos'
    'wl-clipboard: clipboard read/write on Wayland'
    'xclip: clipboard read/write on X11'
    'xsel: clipboard read/write on X11'
    'libnotify: notify-send notifications'
)
source=()
sha256sums=()

_keyloom_source_dir="${KEYLOOM_SOURCE_DIR:-${startdir}/../..}"

# Set KEYLOOM_BUILD_TESTS=ON when invoking makepkg to build the test suite and
# run it in check() (e.g. makepkg -si KEYLOOM_BUILD_TESTS=ON).
_build_tests=${KEYLOOM_BUILD_TESTS:-OFF}

prepare() {
    [[ -f "${_keyloom_source_dir}/CMakeLists.txt" ]] ||
        error 'run makepkg from a complete keyloom checkout'
}

build() {
    cmake -S "${_keyloom_source_dir}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_BINDIR=bin \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=${_build_tests}
    cmake --build build
}

check() {
    if [[ "${_build_tests}" == "ON" ]]; then
        ctest --test-dir build --output-on-failure
    fi
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${_keyloom_source_dir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # .loom file association: MIME type, desktop entry (default handler) and
    # the keyloom-terminal launcher that runs scripts inside a terminal.
    install -Dm644 "${_keyloom_source_dir}/packaging/arch/keyloom-mime.xml" \
        "${pkgdir}/usr/share/mime/packages/keyloom.xml"
    install -Dm644 "${_keyloom_source_dir}/packaging/arch/keyloom.desktop" \
        "${pkgdir}/usr/share/applications/keyloom.desktop"
    # Default-application associations live in $XDG_CONFIG_DIRS/mimeapps.list
    # (/etc/xdg), which takes precedence over /usr/share/applications and is
    # not subject to the unowned-stub conflicts that path can hit.
    install -Dm644 "${_keyloom_source_dir}/packaging/arch/mimeapps.list" \
        "${pkgdir}/etc/xdg/mimeapps.list"
    install -Dm755 "${_keyloom_source_dir}/packaging/arch/keyloom-terminal" \
        "${pkgdir}/usr/bin/keyloom-terminal"
}

post_install() {
    update-mime-database /usr/share/mime
    update-desktop-database /usr/share/applications
}

post_upgrade() {
    post_install
}

post_remove() {
    update-mime-database /usr/share/mime
    update-desktop-database /usr/share/applications
}

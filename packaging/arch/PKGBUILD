# Maintainer: Loomwright contributors
#
# Builds and installs loomwright from a local checkout of this repository; no
# release tarball or network access is involved. Run:
#
#     cd packaging/arch
#     makepkg -si
#
# The source is whatever the checkout contains, committed or not, so this is
# also the way to package work in progress. To publish the package, point
# _loomwright_source_dir at a published source instead of the checkout.

pkgname=loomwright
# Keep this in sync with project(loomwright VERSION ...) in ../../CMakeLists.txt.
pkgver=0.5.7
pkgrel=1
pkgdesc='Linux-first desktop automation language and runtime'
arch=(x86_64 aarch64)
license=(MIT)
# Release artifacts contain the main package only; avoid a distribution-default
# split debug package appearing alongside it when makepkg enables debug symbols.
options=(!debug)
# X11 and libpng support the picker; XCB supports GUI transport development.
# hicolor-icon-theme provides the icon theme the scalable loomwright.svg is
# registered in; the desktop-file-utils and shared-mime-info packages provide
# the cache tools the post-install hook runs.
depends=(
    glibc
    gcc-libs
    libx11
    libxcb
    libpng
    gtk3
    wayland
    hicolor-icon-theme
    desktop-file-utils
    shared-mime-info
)
makedepends=(
    'cmake>=3.25'
    ninja
    pkgconf
)
# ydotool/ydotoold is the preferred output backend for keys, buttons and
# Unicode text. The rest are only needed by specific features: the picker
# captures the desktop with one of the screenshot tools, and clipboard
# integration uses wl-copy/wl-paste or xclip/xsel.
optdepends=(
    'ydotool: buttons, keys and Unicode text via ydotoold (preferred output backend)'
    'spectacle: desktop screenshot for --get-mouse-pos (KDE)'
    'grim: desktop screenshot for --get-mouse-pos (wlroots)'
    'gnome-screenshot: desktop screenshot for --get-mouse-pos (GNOME)'
    'scrot: desktop screenshot for --get-mouse-pos'
    'imagemagick: ImageMagick import as a screenshot fallback for --get-mouse-pos'
    'wl-clipboard: clipboard read/write on Wayland'
    'xclip: clipboard read/write on X11'
    'xsel: clipboard read/write on X11'
    'libnotify: notify-send notifications'
)
source=()
sha256sums=()

# The project was renamed from `keyloom` to `loomwright`. A user who installed
# the old package keeps its files, its command names and its desktop entry.
# `replaces` lets pacman remove the old package during the upgrade, and
# `provides` keeps the old name resolvable, so `pacman -S keyloom` still
# finds a package.
replaces=('keyloom')
provides=('keyloom')

_loomwright_source_dir="${LOOMWRIGHT_SOURCE_DIR:-${startdir}/../..}"

# The files the legacy `keyloom` package installed under the old name. The
# package that replaces it owns the command names now, so only the desktop
# integration files and the license directory are left to clean up.
_legacy_keyloom_files=(
    /usr/share/applications/keyloom.desktop
    /usr/share/icons/hicolor/scalable/apps/keyloom.svg
    /usr/share/mime/packages/keyloom.xml
)

# Set LOOMWRIGHT_BUILD_TESTS=ON when invoking makepkg to build the test suite and
# run it in check() (e.g. makepkg -si LOOMWRIGHT_BUILD_TESTS=ON).
_build_tests=${LOOMWRIGHT_BUILD_TESTS:-OFF}

prepare() {
    [[ -f "${_loomwright_source_dir}/CMakeLists.txt" ]] ||
        error 'run makepkg from a complete loomwright checkout'
}

build() {
    cmake -S "${_loomwright_source_dir}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_BINDIR=bin \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=${_build_tests}
    cmake --build build
}

check() {
    if [[ "${_build_tests}" == "ON" ]]; then
        ctest --test-dir build --output-on-failure
    fi
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${_loomwright_source_dir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # The desktop entry, the scalable icon and the .loom MIME type are
    # installed by CMake (see LOOMWRIGHT_DESKTOP_INTEGRATION), so they are the
    # same files the DEB and RPM packages ship.
    # Default-application associations live in $XDG_CONFIG_DIRS/mimeapps.list
    # (/etc/xdg), which takes precedence over /usr/share/applications and is
    # not subject to the unowned-stub conflicts that path can hit.
    install -Dm644 "${_loomwright_source_dir}/packaging/arch/mimeapps.list" \
        "${pkgdir}/etc/xdg/mimeapps.list"

    # The old command names keep working, so a script, a desktop entry or a
    # scheduled job that still calls `keyloom` keeps running after the
    # upgrade.
    ln -s loomwright "${pkgdir}/usr/bin/keyloom"
    ln -s loomwright-terminal "${pkgdir}/usr/bin/keyloom-terminal"
}

# Remove the desktop integration files of the legacy `keyloom` package. The
# package that replaces it takes its files with it, but a user who removed the
# old package by hand can still have them, and the legacy desktop entry would
# show up in the application menu next to the new one.
remove_legacy_keyloom() {
    # While the old package is still installed, its files belong to it.
    pacman -Qq keyloom >/dev/null 2>&1 && return 0
    local legacy
    for legacy in "${_legacy_keyloom_files[@]}"; do
        [[ -e $legacy ]] || continue
        rm -f "$legacy"
    done
    rm -rf /usr/share/licenses/keyloom
}

post_install() {
    remove_legacy_keyloom
    update-mime-database /usr/share/mime
    update-desktop-database /usr/share/applications
    # Fails without the hicolor icon theme index; the icon is still installed.
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
}

post_upgrade() {
    post_install
}

post_remove() {
    update-mime-database /usr/share/mime
    update-desktop-database /usr/share/applications
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
}
